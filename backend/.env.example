# CampusFix AI Environment Configuration
PORT=5000
NODE_ENV=development

# Google Gemini API (Required for live Gemini AI models)
# If omitted or invalid, CampusFix AI automatically activates the high-fidelity cognitive fallback engine
GEMINI_API_KEY=

# Firebase Firestore Configuration (Optional)
# If omitted, CampusFix AI automatically operates in persistent Local Database mode (backed by disk in backend/data/db.json)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
